{
  "name": "@palmyralabs/template-tribble",
  "version": "0.3.0",
  "description": "Palmyra form, grid and menu page templates for React and Mantine",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/palmyralabs/rt-template-tribble.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/main.js",
  "types": "dist/main.d.ts",
  "exports": {
    ".": {
      "import": "./dist/main.js"
    },
    "./ThemeBlue": "./dist/blue.js",
    "./ThemeOrange": "./dist/orange.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "demoBuild": "tsc && vite build",
    "build": "tsc --p ./build.tsconfig.json && vite --config vite.config.ts build",
    "compile": "tsc --p ./demo.tsconfig.json && tsc --p ./build.tsconfig.json",
    "preview": "vite preview",
    "prepublishOnly": "npm run build",
    "test": "vitest --root test/"
  },
  "devDependencies": {
    "@types/css-modules": "^1.0.5",
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react-swc": "^4.1.0",
    "glob": "^11.0.3",
    "serve-static": "^2.2.0",
    "typescript": "^5.9.3",
    "usehooks-ts": "^3.1.1",
    "vite": "^7.1.9",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-lib-inject-css": "^2.2.2"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "@mantine/core": "^9.1.0",
    "@mantine/hooks": "^9.1.0",
    "@palmyralabs/palmyra-wire": "^1.2.0",
    "@palmyralabs/rt-forms": "^0.3.0",
    "@palmyralabs/rt-forms-mantine": "^0.3.0",
    "@palmyralabs/ts-utils": "^0.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.9.4",
    "react-toastify": "^11.0.5"
  },
  "overrides": {
    "glob": "^11.0.3"
  }
}
